<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.AccountMapper">
  <select id="getAll" resultType="com.example.demo.model.Account">
    SELECT * 
      FROM account
  </select>

  <insert id="insert" parameterType="com.example.demo.model.Account" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO account (name, balance)
    VALUES (#{name}, #{balance})
  </insert>

  <update id="deposit">
    UPDATE account
       SET balance = balance + #{amount}
     WHERE id = #{id}
  </update>

  <update id="withdraw">
    UPDATE account
       SET balance = balance - #{amount}
     WHERE id = #{id}
       AND balance >= #{amount}
  </update>
</mapper>
